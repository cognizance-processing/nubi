# nubi-cloud Fly secrets — the deployment secrets contract.
#
# Two environments, SAME shape so dev mirrors prod for comprehensive testing:
#   cp .env.deploy.example .env       # production  → app "nubi",     push: scripts/secrets.sh
#   cp .env.deploy.example .env.dev   # dev/testing → app "nubi-dev", push: scripts/secrets.sh dev
#
# Keep .env and .env.dev IDENTICAL except the per-env values marked  [PER-ENV]
# below (separate database, separate public URLs). Both
# are gitignored — NEVER commit real values. See nubi's docs/cloud.md for the
# full set of tunables.

# ── Activates the EE/billing layer ─────────────────────────────────────────
# Runtime switch: load_ee() + the licensing module read this; it flips billing
# and paid tiers on (surfaced to the SPA via GET /features). Absent → the same
# image runs as plain OSS Nubi. Keep the SAME on dev and prod so dev exercises
# every paid path.
NUBI_LICENSE_KEY=

# ── Database (Neon Postgres) ───────────────────────────────────────────────
# [PER-ENV] Use a SEPARATE database/branch for dev — never point dev at prod.
# Core + EE migrations run against this on every deploy (release_command).
DATABASE_URL=

# ── Billing (Paystack) ─────────────────────────────────────────────────────
PAYSTACK_SECRET_KEY=

# ── Object storage (Cloudflare R2, S3-compatible) ──────────────────────────
FLOWS_MATERIALIZE_BASE_URI=
S3_ENDPOINT_URL=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=
S3_BUCKET=

# ── App config (should match nubi's .env.main / .env.dev) ──────────────────
JWT_SECRET=
CONNECTOR_SECRET_KEY=
CONNECTOR_SECRET_KEY_VERSION=
# [PER-ENV] Public URLs / CORS: prod = https://nubi.app, dev = https://dev.nubi.app
FRONTEND_URL=https://nubi.app
CORS_ORIGINS=https://nubi.app

# ── AI / LLM providers ─────────────────────────────────────────────────────
# Vendor API keys the deployment serves metered (wallet-billed) calls with.
# Set the keys for whichever providers you enable below.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
# Which LiteLLM providers to expose in GET /ai/providers (model picker + BYO).
# Only these appear in the UI, and their curated models + pricing are synced
# from litellm.model_cost. Default: all three.
NUBI_AI_ENABLED_PROVIDERS=anthropic,openai,gemini

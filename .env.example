# =============================================================================
# Nubi — environment variable reference
# Copy to .env (never commit .env)
# =============================================================================

# -----------------------------------------------------------------------------
# Frontend (Vite — prefix VITE_ to expose to the browser bundle)
# -----------------------------------------------------------------------------

# Base URL of the FastAPI backend, no trailing slash.
VITE_BACKEND_URL=http://localhost:8000

# -----------------------------------------------------------------------------
# Backend (FastAPI / pydantic-settings — loaded from .env when running uvicorn)
# -----------------------------------------------------------------------------

# Neon Postgres connection string.
# sslmode=require is mandatory for Neon; omitting it will cause connection errors.
DATABASE_URL=postgresql://user:password@host.neon.tech/dbname?sslmode=require

# HS256 signing secret for JWT access tokens.
# Generate a strong secret with: openssl rand -hex 32
JWT_SECRET=replace-me-with-openssl-rand-hex-32-output

# Access token lifetime in minutes. Default: 15.
JWT_ACCESS_TTL_MIN=15

# Google OAuth 2.0 credentials — OPTIONAL.
# Leave all three EMPTY to run with email/password sign-in only: the backend
# disables /auth/google/* and reports google_oauth=false, so the SPA hides the
# "Continue with Google" button. To enable Google sign-in, create a project at
# https://console.cloud.google.com/apis/credentials and add GOOGLE_REDIRECT_URI
# as an authorised redirect URI. All three are required together.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# URL of the frontend (React/Vite) app.
# The backend's Google OAuth callback redirects here after a successful sign-in.
FRONTEND_URL=http://localhost:5173

# Comma-separated list of allowed CORS origins.
# Must include every origin the frontend is served from.
CORS_ORIGINS=http://localhost:5173

# Set to false in local development (non-HTTPS) so the refresh cookie is not
# flagged Secure. Always true in staging/production.
COOKIE_SECURE=false

# Runtime environment label. Disables /docs and /redoc when set to "production".
# Values: development | test | production
ENV=development

# -----------------------------------------------------------------------------
# AI / LLM provider  (all optional — with none set, AI runs in offline NullProvider mode)
# -----------------------------------------------------------------------------
# LiteLLM is the PRIMARY completion path: anthropic/openai/gemini are ALWAYS
# routed through LiteLLMProvider (one in-process SDK, "provider/model" strings,
# per-model pricing via litellm.completion_cost — no separate proxy server).
# Selects the LLM backend. Leave unset to auto-detect from the keys below.
# Values: litellm | anthropic | openai | gemini
# LLM_PROVIDER=litellm

# ── Vendor API keys (auto-detected with no LLM_PROVIDER; also used when
#    LLM_PROVIDER=anthropic/openai/gemini — either way, calls route through
#    LiteLLMProvider). The legacy native AnthropicProvider/OpenAIProvider/
#    GeminiProvider classes are still importable for direct/explicit use but
#    are no longer returned by get_provider(). ──
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=

# Comma-separated providers exposed via GET /ai/providers and eligible for
# per-org BYO keys (POST/DELETE /ai/keys, paid tiers only — see
# app/ee/billing/org_ai_keys.py). Default: all three.
# NUBI_AI_ENABLED_PROVIDERS=anthropic,openai,gemini

# Markup % applied on top of the raw litellm.completion_cost when charging a
# metered (non-BYO) call's token overage from the org's usage wallet:
# usd_marked_up = usd_cost * (1 + NUBI_TOKEN_MARKUP_PCT / 100). Default: 7.5.
# NUBI_TOKEN_MARKUP_PCT=7.5

# ── LiteLLM raw-model-string path (LLM_PROVIDER=litellm) — bypasses the
#    per-vendor allowlist above for a specific model string, e.g. a
#    self-hosted/Ollama model LiteLLM supports that ALLOWED_MODELS doesn't list. ──
# Default model as a "provider/model" string (required when using LiteLLM):
#   anthropic/claude-opus-4-8 | gpt-4o | gemini/gemini-1.5-pro | ollama/llama3 | ...
# LITELLM_MODEL=anthropic/claude-opus-4-8
# Comma-separated extra models a request may select via the API `model` field
# (the default above is always allowed):
# LITELLM_ALLOWED_MODELS=anthropic/claude-sonnet-4-6,gpt-4o-mini
# Explicit key (optional — usually omitted; LiteLLM reads the *_API_KEY vars above):
# LITELLM_API_KEY=
# Resilience: auto-retry 429/5xx/timeout, and request timeout in seconds:
# LITELLM_NUM_RETRIES=2
# LITELLM_TIMEOUT=60
# Soft per-process USD spend cap — calls past this raise llm_budget_exceeded (429):
# LITELLM_MAX_BUDGET_USD=

# -----------------------------------------------------------------------------
# Kernel / compute
# -----------------------------------------------------------------------------

# Allow the local subprocess kernel (dev/test only). Default: true in dev, false in prod.
# Set to false in production and configure a sandboxed remote runner below.
KERNEL_LOCAL_ENABLED=true

# Remote sandbox provider. Set to 'e2b' (Firecracker microVM) or 'modal'.
# KERNEL_REMOTE_PROVIDER=e2b
# E2B_API_KEY=e2b-...
# MODAL_TOKEN_ID=
# MODAL_TOKEN_SECRET=

# -----------------------------------------------------------------------------
# Jobs / flows scheduler
# -----------------------------------------------------------------------------

# Set to true to activate the background tick that runs due jobs on JOBS_SCHEDULER_INTERVAL_S.
JOBS_SCHEDULER_ENABLED=false
JOBS_SCHEDULER_INTERVAL_S=30

# Set to true to activate the background flows worker.
FLOWS_WORKER_ENABLED=false
FLOWS_WORKER_INTERVAL_S=5

# Shared secret for the internal POST /flows/tick endpoint used by external cron schedulers.
# Leave empty to disable the /flows/tick endpoint.
# FLOWS_TICK_SECRET=

# Base URI for materialized flow models (leave empty → local path, fine for dev only).
# Use an s3:// or r2:// URI in production so targets survive container restarts.
# FLOWS_MATERIALIZE_BASE_URI=s3://my-bucket/flows

# -----------------------------------------------------------------------------
# Snapshot / demo / public exports
# -----------------------------------------------------------------------------

# Deployment-wide kill switch for UNSAFE no-auth public exports (Mode 3b).
# Both this flag AND the org-level 'public_exports' feature gate must be true.
# Default: false. NEVER enable in production without understanding the security implications.
ALLOW_UNSAFE_PUBLIC_EXPORTS=false

# Override the per-collect row cap for snapshot/report collect_board_data calls.
# Default: 50000. 0 = unlimited.
# NUBI_COLLECT_ROW_CAP=50000

# -----------------------------------------------------------------------------
# Embed dev token (DEV ONLY — NEVER in production)
# -----------------------------------------------------------------------------

# When true, enables POST /api/v1/embed/embed-token — a convenience endpoint
# that mints HS256 embed tokens for local dev WITHOUT your asymmetric key.
# MUST be false (or unset) in production. Production embeds use RS256/ES256 JWTs
# signed by your backend with a key registered via Settings → Security → JWT issuers.
EMBED_DEV_TOKEN_ENABLED=false

# -----------------------------------------------------------------------------
# FX rate (EE billing — ZAR/USD conversion)
# -----------------------------------------------------------------------------

# Emergency fallback USD→ZAR rate used when no live rate has been fetched within
# the staleness window (72 h). Update quarterly. Actual rate is fetched daily
# from frankfurter.app (primary) / open.er-api.com (fallback). EE only.
# FX_EMERGENCY_RATE=16.26

# =============================================================================
# EE Billing — Paystack, SMTP, business entity & VAT  (Enterprise Edition only)
# =============================================================================
# These are read by app/ee/billing/*. OSS / non-EE builds ignore them.

# ── Paystack (we collect in ZAR) ─────────────────────────────────────────────
# Secret key from your Paystack dashboard. Test keys start with sk_test_.
PAYSTACK_SECRET_KEY=

# ── Outbound SMTP (invoice + report email delivery) ──────────────────────────
# Leave SMTP_HOST blank to disable real delivery (uses an in-memory NullSender).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_FROM=

# ── Business entity shown on invoice PDFs ────────────────────────────────────
COMPANY_NAME=Nubi
COMPANY_LEGAL_NAME=Nubi (Pty) Ltd
COMPANY_REG_NUMBER=
# IMPORTANT: VAT is charged ONLY when COMPANY_VAT_NUMBER is non-empty.
# Not VAT-registered yet? Leave it blank → no VAT line is added to invoices.
COMPANY_VAT_NUMBER=
COMPANY_VAT_RATE=0.15
# Use \n for line breaks in the address.
COMPANY_ADDRESS=
COMPANY_EMAIL=billing@nubi.io
COMPANY_WEBSITE=https://nubi.io
BILLING_EMAIL=billing@nubi.io
INVOICE_NUMBER_PREFIX=NUBI
INVOICE_CURRENCY=ZAR

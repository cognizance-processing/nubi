# Fly secrets contract for a self-hosted Nubi on Fly.io.
#
#   cp deploy/fly/.env.fly.example .env.fly     # gitignored — never commit real values
#   NUBI_FLY_APP=my-nubi deploy/fly/secrets.sh .env.fly
#
# One file per Fly app (e.g. .env.fly, .env.fly-staging). See docs/self-host.md
# and .env.example at the repo root for every tunable.

# ── Activates the EE/billing layer ─────────────────────────────────────────
# Leave EMPTY for self-hosting: the image then runs as plain OSS Nubi with the
# billing layer inert. See docs/open-core.md.
NUBI_LICENSE_KEY=

# ── Database (any Postgres: Neon, Supabase, Fly Postgres, RDS, …) ──────────
# Core + EE migrations run against this on every deploy (release_command).
DATABASE_URL=

# ── Billing (Paystack) ─────────────────────────────────────────────────────
PAYSTACK_SECRET_KEY=

# ── Object storage (Cloudflare R2, S3-compatible) ──────────────────────────
FLOWS_MATERIALIZE_BASE_URI=
S3_ENDPOINT_URL=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=
S3_BUCKET=

# ── App config (should match nubi's .env.main / .env.dev) ──────────────────
JWT_SECRET=
CONNECTOR_SECRET_KEY=
CONNECTOR_SECRET_KEY_VERSION=
# Public URL of this deployment (CORS is locked to it). One per Fly app.
FRONTEND_URL=https://your-domain.example
CORS_ORIGINS=https://your-domain.example

# ── AI / LLM providers ─────────────────────────────────────────────────────
# Vendor API keys the deployment serves metered (wallet-billed) calls with.
# Set the keys for whichever providers you enable below.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
# Which LiteLLM providers to expose in GET /ai/providers (model picker + BYO).
# Only these appear in the UI, and their curated models + pricing are synced
# from litellm.model_cost. Default: all three.
NUBI_AI_ENABLED_PROVIDERS=anthropic,openai,gemini

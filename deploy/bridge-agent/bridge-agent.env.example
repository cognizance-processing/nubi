# Nubi bridge agent configuration.
#
# Install to /etc/nubi/bridge-agent.env with restrictive permissions — this file
# holds a credential that can reach inside your network:
#
#     sudo install -D -m 0600 -o root -g root \
#         bridge-agent.env.example /etc/nubi/bridge-agent.env
#
# All three required values are shown by Nubi when you create the bridge
# (connector form → "connect a private database", or Settings → Bridges).
# BRIDGE_TOKEN is displayed EXACTLY ONCE and stored only as a hash — if you lose
# it, rotate to get a new one rather than trying to recover it.

# UUID of the bridge record in Nubi.
BRIDGE_ID=00000000-0000-0000-0000-000000000000

# Secret token authenticating this agent. Treat it like a password.
BRIDGE_TOKEN=nubi_br_replace_me

# Your Nubi control plane, as a WebSocket URL (wss:// in production).
CONTROL_PLANE_URL=wss://your-nubi-host/api/v1

# Optional — seconds between reconnect attempts after the tunnel drops.
# BRIDGE_RECONNECT_DELAY=5

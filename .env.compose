# =============================================================================
# Nubi — docker-compose environment (backend service, see docker-compose.yml)
#
# This file is COMMITTED with safe placeholder values only — it is never
# deployed as-is. Before running against anything but a throwaway local
# stack, copy it and fill in real secrets:
#
#   cp .env.compose .env.compose.local
#   # then point docker compose at it, e.g.:
#   docker compose --env-file .env.compose.local up -d --build
#
# See docs/self-host.md#configuration for the full variable reference.
# =============================================================================

# -----------------------------------------------------------------------------
# Required
# -----------------------------------------------------------------------------

# HS256 signing key (minimum 32 bytes; enforced at startup). Generate a real
# one with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=replace-me-with-openssl-rand-hex-32-output

# -----------------------------------------------------------------------------
# Recommended
# -----------------------------------------------------------------------------

# AES-256-GCM key for connector credentials at rest — required to use any
# database connector (PostgreSQL, MySQL, BigQuery, etc). Generate with:
# python -c "import os,base64; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
# CONNECTOR_SECRET_KEY=

# MinIO / S3-compatible object storage credentials (defaults match the
# minio/minio-init services in docker-compose.yml).
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# Set to true when serving over HTTPS.
COOKIE_SECURE=false

# -----------------------------------------------------------------------------
# Optional: Google sign-in — leave all three empty to run email/password only
# -----------------------------------------------------------------------------

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# -----------------------------------------------------------------------------
# Runtime tunables
# -----------------------------------------------------------------------------

ENV=development
CORS_ORIGINS=http://localhost:8080
FRONTEND_URL=http://localhost:8080
UVICORN_WORKERS=2
FLOWS_WORKER_ENABLED=true

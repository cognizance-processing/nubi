{
  "name": "nubi",
  "private": true,
  "version": "0.8.2",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "cd backend && python -m uvicorn main:app --reload --host 0.0.0.0 --port 8000",
    "dev:full": "concurrently -k -n api,web -c blue,green \"npm:dev:api\" \"npm:dev\"",
    "db:reset": "cd backend && python reset_db.py",
    "db:reset:demo": "cd backend && python reset_db.py --demo",
    "build": "vite build --mode main",
    "build:dev": "vite build --mode dev",
    "build:main": "vite build --mode main",
    "build:embed": "vite build --config embed/vite.embed.config.ts",
    "build:widgets": "vite build --config vite.widgets.config.js",
    "lint": "eslint .",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "typecheck:embed": "tsc --noEmit -p embed/tsconfig.json",
    "typecheck:sdk": "tsc --noEmit -p sdk/tsconfig.json",
    "typecheck:all": "npm run typecheck && npm run typecheck:embed && npm run typecheck:sdk",
    "test:dash": "node --import tsx --test 'src/**/*.test.{mjs,ts,tsx}'",
    "test:embed": "vitest run --config embed/vitest.config.ts",
    "test:embed:watch": "vitest --config embed/vitest.config.ts",
    "test:e2e": "playwright test",
    "test:e2e:embed": "playwright test --config embed/e2e/playwright.config.ts",
    "test:e2e:api": "cd backend && RUN_E2E=1 python -m pytest tests/e2e -q",
    "test:e2e:embed:live": "RUN_E2E_EMBED_LIVE=1 playwright test --config embed/e2e/playwright.config.ts embed/e2e/specs/embed-live-backend.spec.ts",
    "screenshots": "node scripts/docs-screenshots.mjs",
    "screenshots:auto": "bash scripts/screenshots.sh"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/utilities": "^3.2.2",
    "@duckdb/duckdb-wasm": "^1.33.1-dev45.0",
    "@monaco-editor/react": "^4.7.0",
    "@phosphor-icons/react": "^2.1.10",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.14.2",
    "apache-arrow": "^21.1.0",
    "diff": "^8.0.3",
    "dompurify": "^3.2.6",
    "echarts": "^5.6.0",
    "html2canvas": "^1.4.1",
    "js-yaml": "^4.1.0",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.564.0",
    "mermaid": "^11.16.0",
    "papaparse": "^5.5.3",
    "prismjs": "^1.30.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.13.0",
    "react-syntax-highlighter": "^16.1.0",
    "reactflow": "^11.11.4",
    "regl": "^2.1.0",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.60.0",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.4.24",
    "concurrently": "^10.0.3",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "jsdom": "^26.1.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^7.3.1",
    "vitest": "^3.2.6"
  }
}

# nubi-cloud local single-instance config — copy to .env.local (gitignored).
# Used by docker-compose.local.yml / scripts/dev-local.sh.
#
# DATABASE_URL and S3_* are injected by the compose file (local Postgres + MinIO)
# — do NOT set them here.

# Turn the EE/billing layer on locally so you can test billing/paid paths.
# (Any value load_ee's licensing module accepts as a paid tier.)
NUBI_LICENSE_KEY=

# Local dev settings (non-HTTPS, same-origin SPA served by the backend).
ENV=development
COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:8000
FRONTEND_URL=http://localhost:8000

# Secrets / crypto — generate locally:
#   JWT_SECRET:           python -c "import secrets;print(secrets.token_hex(32))"
#   CONNECTOR_SECRET_KEY: python -c "import os,base64;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
JWT_SECRET=
CONNECTOR_SECRET_KEY=
CONNECTOR_SECRET_KEY_VERSION=1

# Billing (Paystack) — optional locally; use TEST keys to exercise checkout.
PAYSTACK_SECRET_KEY=
